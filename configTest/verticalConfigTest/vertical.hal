# HAL configuration for vertical machine with Remora firmware (XYZ, 3-joint)

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

loadrt remora-spi
loadrt PRUencoder names=encoder.0
loadrt conv_float_s32 names=mpg-conv
loadrt mux4 names=mpg-scale-mux

# Thread functions
addf remora.read                 servo-thread
addf motion-command-handler      servo-thread
addf motion-controller           servo-thread
addf remora.update-freq          servo-thread
addf remora.write                servo-thread
addf PRUencoder.capture-position servo-thread
addf mpg-conv                    servo-thread
addf mpg-scale-mux               servo-thread

# ============================================================================
# ESTOP and SPI Communication
# ============================================================================
net user-enable-out      <=  iocontrol.0.user-enable-out      =>  remora.SPI-enable
net user-request-enable  <=  iocontrol.0.user-request-enable  =>  remora.SPI-reset
net remora-status        <=  remora.SPI-status                =>  iocontrol.0.emc-enable-in

# Tool change loopback (unlinked in postgui for manual tool change)
net tool-prep-loop    iocontrol.0.tool-prepare   iocontrol.0.tool-prepared
net tool-change-loop  iocontrol.0.tool-change    iocontrol.0.tool-changed

# ============================================================================
# STEPGEN - JOINT CONFIGURATION
# ============================================================================

# Joint 0 - X Axis
setp remora.joint.0.scale    [JOINT_0]SCALE
setp remora.joint.0.maxaccel [JOINT_0]STEPGEN_MAX_ACC
setp remora.joint.0.pgain    [JOINT_0]P_GAIN
setp remora.joint.0.ff1gain  [JOINT_0]FF1_GAIN
setp remora.joint.0.deadband [JOINT_0]DEADBAND

net j0pos-cmd  <=  joint.0.motor-pos-cmd  =>  remora.joint.0.pos-cmd
net j0pos-fb   <=  remora.joint.0.pos-fb  =>  joint.0.motor-pos-fb
net j0enable   <=  joint.0.amp-enable-out  =>  remora.joint.0.enable

# Joint 1 - Y Axis
setp remora.joint.1.scale    [JOINT_1]SCALE
setp remora.joint.1.maxaccel [JOINT_1]STEPGEN_MAX_ACC
setp remora.joint.1.pgain    [JOINT_1]P_GAIN
setp remora.joint.1.ff1gain  [JOINT_1]FF1_GAIN
setp remora.joint.1.deadband [JOINT_1]DEADBAND

net j1pos-cmd  <=  joint.1.motor-pos-cmd  =>  remora.joint.1.pos-cmd
net j1pos-fb   <=  remora.joint.1.pos-fb  =>  joint.1.motor-pos-fb
net j1enable   <=  joint.1.amp-enable-out  =>  remora.joint.1.enable

# Joint 2 - Z Axis
setp remora.joint.2.scale    [JOINT_2]SCALE
setp remora.joint.2.maxaccel [JOINT_2]STEPGEN_MAX_ACC
setp remora.joint.2.pgain    [JOINT_2]P_GAIN
setp remora.joint.2.ff1gain  [JOINT_2]FF1_GAIN
setp remora.joint.2.deadband [JOINT_2]DEADBAND

net j2pos-cmd  <=  joint.2.motor-pos-cmd  =>  remora.joint.2.pos-cmd
net j2pos-fb   <=  remora.joint.2.pos-fb  =>  joint.2.motor-pos-fb
net j2enable   <=  joint.2.amp-enable-out  =>  remora.joint.2.enable

# Joint 3 - A Axis
setp remora.joint.3.scale    [JOINT_3]SCALE
setp remora.joint.3.maxaccel [JOINT_3]STEPGEN_MAX_ACC
setp remora.joint.3.pgain    [JOINT_3]P_GAIN
setp remora.joint.3.ff1gain  [JOINT_3]FF1_GAIN
setp remora.joint.3.deadband [JOINT_3]DEADBAND

net j3pos-cmd  <=  joint.3.motor-pos-cmd  =>  remora.joint.3.pos-cmd
net j3pos-fb   <=  remora.joint.3.pos-fb  =>  joint.3.motor-pos-fb
net j3enable   <=  joint.3.amp-enable-out  =>  remora.joint.3.enable

# ============================================================================
# SPINDLE CONTROL
# ============================================================================
# Spindle PWM: remora.SP.0
# Forward: PE_14 -> remora.output.13  /  Reverse: PE_15 -> remora.output.14
net spindle-speed-cmd  spindle.0.speed-out  =>  remora.SP.0
net spindle-forward    spindle.0.forward    =>  remora.output.13
net spindle-reverse    spindle.0.reverse    =>  remora.output.14

# ============================================================================
# SPINDLE ENCODER (QEI via remora.PV.2, Index: remora.input.14)
# ============================================================================
setp encoder.0.position-scale 2000.0
setp encoder.0.index-enable true

net spindle-raw-count     <=  remora.PV.2          =>  encoder.0.raw_count
net spindle-index         <=  remora.input.14      =>  encoder.0.phase-Z
net spindle-pos               encoder.0.position   =>  spindle.0.revs
net spindle-vel               encoder.0.velocity   =>  spindle.0.speed-in
net spindle-index-enable       encoder.0.index-enable spindle.0.index-enable

# ============================================================================
# MPG HANDWHEEL JOGGING (remora.PV.4)
# ============================================================================
net mpg-raw-count  <=  remora.PV.4  =>  mpg-conv.in
net mpg-counts     <=  mpg-conv.out

setp mpg-scale-mux.in0 [MPG]SCALE_0
setp mpg-scale-mux.in1 [MPG]SCALE_1
setp mpg-scale-mux.in2 [MPG]SCALE_2
setp mpg-scale-mux.in3 [MPG]SCALE_3

net mpg-scale-sel0  =>  mpg-scale-mux.sel0
net mpg-scale-sel1  =>  mpg-scale-mux.sel1
net mpg-scale       <=  mpg-scale-mux.out

# MPG Jog - counts and scale connected to all joints
# jog-enable pins are connected in vertical_postgui.hal (qtdragon pins)
net mpg-counts    =>  joint.0.jog-counts  axis.x.jog-counts
net mpg-scale     =>  joint.0.jog-scale   axis.x.jog-scale
setp joint.0.jog-vel-mode 0

net mpg-counts    =>  joint.1.jog-counts  axis.y.jog-counts
net mpg-scale     =>  joint.1.jog-scale   axis.y.jog-scale
setp joint.1.jog-vel-mode 0

net mpg-counts    =>  joint.2.jog-counts  axis.z.jog-counts
net mpg-scale     =>  joint.2.jog-scale   axis.z.jog-scale
setp joint.2.jog-vel-mode 0

net mpg-counts    =>  joint.3.jog-counts  axis.a.jog-counts
net mpg-scale     =>  joint.3.jog-scale   axis.a.jog-scale
setp joint.3.jog-vel-mode 0

# Default MPG scale selection (index 1 = 0.01 mm/click)
sets mpg-scale-sel0 1
sets mpg-scale-sel1 0
