<?xml version="1.0" encoding="UTF-8"?>
<!--
    PyVCP Control Panel for Remora CNC Controller
    Based on config.txt pin mappings
    
    ========== OUTPUT PIN MAPPING (from config.txt) ==========
    Bit 00 - PA_8  - OUTPUT_0 (General Purpose)
    Bit 01 - PD_14 - OUTPUT_1 (General Purpose)
    Bit 02 - PD_15 - OUTPUT_2 (General Purpose)
    Bit 03 - PD_12 - OUTPUT_3 (General Purpose)
    Bit 04 - PD_13 - OUTPUT_4 (General Purpose)
    Bit 05 - PD_10 - OUTPUT_5 (General Purpose)
    Bit 06 - PB_12 - OUTPUT_6 (General Purpose)
    Bit 07 - PB_13 - OUTPUT_7 (General Purpose)
    Bit 08 - PE_9  - OUTPUT_8 (General Purpose)
    Bit 09 - PE_8  - OUTPUT_9 (General Purpose)
    Bit 10 - PE_10 - OUTPUT_10 (General Purpose)
    Bit 11 - PB_11 - OUTPUT_11 (General Purpose)
    Bit 12 - PB_10 - OUTPUT_12 (General Purpose)
    
    ========== INPUT PIN MAPPING (from config.txt) ==========
    RESET_PIN - PA_3  - Reset Pin (PRU Reset - not digital input)
    Bit 00 - PE_4  - INPUT_0 (General Input)
    Bit 01 - PE_6  - INPUT_1 (General Input)
    Bit 02 - PC_13 - INPUT_2 (General Input)
    Bit 03 - PC_0  - INPUT_3 (General Input)
    Bit 04 - PC_1  - INPUT_4 (General Input)
    Bit 05 - PC_2  - INPUT_5 (General Input)
    Bit 06 - PC_3  - INPUT_6 (General Input)
    Bit 07 - PC_4  - INPUT_7 (General Input)
    Bit 08 - PC_5  - INPUT_8 (General Input)
    Bit 09 - PB_0  - INPUT_9 (General Input)
    Bit 10 - PB_1  - INPUT_10 (General Input)
    Bit 11 - PB_2  - INPUT_11 (General Input)
    Bit 12 - PE_7  - INPUT_12 (General Input)
    Bit 13 - PE_2  - HALT (General Input)
    Bit 14 - PA_2  - QEI Index (reserved for encoder)
    
    ========== PWM OUTPUTS (from config.txt) ==========
    SP[0] - Spindle PWM
    SP[3] - PWM_0 (PB_14)
    SP[5] - PWM_1 (PB_15)
    
    ========== PROCESS VARIABLES (from config.txt) ==========
    PV[0] - Temperature Sensor 1
    PV[1] - Temperature Sensor 2
    PV[2] - QEI Encoder Count
    PV[3] - Temperature Sensor 3
    PV[4] - MPG Encoder Count
-->

<pyvcp>
    <!-- ================================================================ -->
    <!-- HALT (PRU RESET) CONTROL -->
    <!-- ================================================================ -->
    <labelframe text="MCU Control">
        <font>("Helvetica", 12, "bold")</font>
        <relief>RAISED</relief>
        <bd>3</bd>
        
        <hbox>
            <label><text>"STM32 HALT:"</text><width>12</width></label>
            <button>
                <halpin>"pru-reset-btn"</halpin>
                <text>"HALT MCU"</text>
                <font>("Helvetica", 10, "bold")</font>
                <bg>"red"</bg>
                <fg>"white"</fg>
                <activebackground>"dark red"</activebackground>
                <width>12</width>
            </button>
            <label><text>" (PE_2 → GPIO 25)"</text><font>("Helvetica", 8)</font></label>
        </hbox>
    </labelframe>

    <!-- ================================================================ -->
    <!-- SPINDLE & COOLANT STATUS (Read Only) -->
    <!-- ================================================================ -->
    <labelframe text="Spindle &amp; Coolant Status">
        <font>("Helvetica", 12, "bold")</font>
        <relief>RAISED</relief>
        <bd>3</bd>
        
        <hbox>
            <vbox>
                <label>
                    <text>"─── Spindle ───"</text>
                    <font>("Helvetica", 10, "bold")</font>
                </label>
                
                <hbox>
                    <label><text>"Forward:"</text><width>14</width></label>
                    <led>
                        <halpin>"spindle-fwd-led"</halpin>
                        <size>20</size>
                        <on_color>"green"</on_color>
                        <off_color>"dark green"</off_color>
                    </led>
                </hbox>
                
                <hbox>
                    <label><text>"Reverse:"</text><width>14</width></label>
                    <led>
                        <halpin>"spindle-rev-led"</halpin>
                        <size>20</size>
                        <on_color>"yellow"</on_color>
                        <off_color>"dark red"</off_color>
                    </led>
                </hbox>
            </vbox>
            
            <vbox>
                <label>
                    <text>"─── Coolant ───"</text>
                    <font>("Helvetica", 10, "bold")</font>
                </label>
                
                <hbox>
                    <label><text>"Flood:"</text><width>14</width></label>
                    <led>
                        <halpin>"flood-led"</halpin>
                        <size>20</size>
                        <on_color>"blue"</on_color>
                        <off_color>"dark blue"</off_color>
                    </led>
                </hbox>
                
                <hbox>
                    <label><text>"Mist:"</text><width>14</width></label>
                    <led>
                        <halpin>"mist-led"</halpin>
                        <size>20</size>
                        <on_color>"cyan"</on_color>
                        <off_color>"dark cyan"</off_color>
                    </led>
                </hbox>
            </vbox>
        </hbox>
    </labelframe>
    
